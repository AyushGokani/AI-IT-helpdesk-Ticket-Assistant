# Flask
FLASK_DEBUG=1
FLASK_SECRET_KEY=change-me-in-production
PORT=5001

# OpenAI — leave blank to use the offline heuristic generator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Jira — leave blank to use built-in demo tickets
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_JQL=project = DEMO ORDER BY updated DESC

# Pipeline
CUKE_MAX_FIX_ITERATIONS=3
CUKE_WORKSPACE_ROOT=workspaces
