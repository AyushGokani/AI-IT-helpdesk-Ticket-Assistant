# Copy to .env and fill in. The app works without a key (uses heuristic fallback),
# but real LLM responses require an OpenAI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Generate a strong value with:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-in-prod

# Optional: where local SQLite + uploads live. Defaults to ./data.
# DATA_DIR=./data

# Optional: full database connection string. If unset, Triagent uses a local
# SQLite file at $DATA_DIR/triagent.sqlite3 — perfect for local dev. In
# production, Render injects a Postgres URL automatically.
# DATABASE_URL=postgresql://user:pass@host:5432/triagent

# Optional: when a new user signs up, auto-populate their account with 8 demo
# tickets so the first login isn't an empty inbox. Recommended for live demos.
# SEED_DEMO_DATA=1

# Set to 0 in production. Local dev defaults to 1 in wsgi.py.
# FLASK_DEBUG=0

# Set to 1 in production (HTTPS) to mark the session cookie Secure.
# SESSION_COOKIE_SECURE=1

# ----------------------------------------------------------------------------
# Email (used for password reset codes). Pick ONE backend by setting the vars
# below. If none are set, codes are printed to stdout (Render logs / terminal)
# — fine for local dev and for demos.
# ----------------------------------------------------------------------------

# Option A — Gmail SMTP. Requires a 16-char "App Password" (not your Gmail
# login password). https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Option B — Resend (https://resend.com, free 100/day, sign in with GitHub).
# RESEND_API_KEY=re_...

# What "From:" address shows up. Defaults to SMTP_USER (Gmail) or a placeholder.
# EMAIL_FROM=Triagent <no-reply@yourdomain.com>
